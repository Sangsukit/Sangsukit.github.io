นที่ป่าอย่างยั่งยืน ที่ประชุมยังเห็นควรเสนอที่ประชุมคณะกรรมาธิการ ให้ตั้งคณะทำงานใหม่ 2 คณะ คือ คณะทำงานศึกษากรอบนโยบายQuick-Win ด้านการป่าไม้แห่งชาติและพื้นที่สีเขียว และคณะทำงานบูรณาการแผนรับมือวิกฤตปัญหาช้างป่าและชุมชน สรุปจากเอกสารสรุปผลการประชุมของคณะอนุกรรมา","tg":[]},{"k":"m","t":"การประชุมคณะอนุกรรมาธิการการบริหารจัดการน้ำทั้งระบบ มลพิษและสิ่งแวดล้อม ครั้งที่ 2/2569","u":"/environment/2569/m/water-first-2.html","c":"environment","sb":75,"n":2,"y":2569,"d":"2026-01-20","tm":"09.30","r":"ห้องประชุมกรรมาธิการ CA 331 ชั้น 3 อาคารรัฐสภา","s":"","it":[],"tg":[],"ch":"","cr":"","dk":["summary","notice","agenda"],"du0":"https://pis.parliament.go.th/PARFileDownloadProxy/download?s=xDfWSm6fywUhPdDboNd2fnWyq8XTxDscP9ghDAS_ugG4jSiBQsB8URf1f-6PaCOLFHfIGlJlyV_TmS5pjOF_g1Z1ogmr6D8XX3Sd7THezLqL2XksrYocX19wJLM2W7XbSQ4icvQYjdmCNr9ghfwog6TH-92fys3D3cM=&ref=9330971","dk0":"summary","v":[],"ph":1,"ao":0,"cx":0,"read":"/environment/2569/sub-water-first.html#read-2"},{"k":"m","t":"การประชุมคณะอนุกรรมาธิการการบริหารจัดการน้ำทั้งระบบ มลพิษและสิ่งแวดล้อม ครั้งที่ 1/2569","u":"/environment/2569/m/water-first-1.html","c":"environment","sb":75,"n":1,"y":2569,"d":"2026-01-13","tm":"10.00","r":"ห้องประชุมกรรมาธิการ CA 331 ชั้น 3 อาคารรัฐสภา","s":"","it":[],"tg":[],"ch":"","cr":"","dk":["summary","notice","agenda","minutes"],"du0":"https://pis.parliament.go.th/PARFileDownloadProxy/download?s=8l3ReiUPiN9y7DsByGI1dSYQyk_0r6mPAlRYM2akzvgKLaP7CdS6vtiCFQGX5HGdrOoAZJhTLtJOIuBvW3Hyerha_GNOWG5jGXEBLxyTG5h_7z_7kw3Br5nnHJDDt1IPsEhVk6HVnk-al4hrF1WHD48TH8pB5XZJpno=&ref=9277412","dk0":"summary","v":[],"ph":1,"ao":0,"cx":0,"read":"/environment/2569/sub-water-first.html#read-1"},{"k":"m","t":"การประชุมคณะอนุกรรมาธิการการบริหารจัดการน้ำทั้งระบบ มลพิษและสิ่งแวดล้อม ครั้งที่ 12/2569","u":"/environment/2569/m/water-second-12.html","c":"environment","sb":76,"n":12,"y":2569,"d":"2026-10-01","tm":"","r":"","s":"","it":[],"tg":[],"ch":"","cr":"","dk":["notice"],"du0":"https://pis.parliament.go.th/PARFileDownload