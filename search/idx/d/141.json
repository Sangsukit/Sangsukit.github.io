tps://pis.parliament.go.th/PARFileDownloadProxy/download?s=KYvxMcmh0P1Y7Z7OrxdkdtQCUgQSnEZukbk4gYMSdd6lYWiCQtk0JonUdihONypTPIVD8jmQMmoSV1iM2OK0r81jfWGDdyQGT9kv16QkpFXFVtvVKH7nA6T_PUeZhbPZNRyC9orssF4z9rF5GtNuASz_flKkP_OFs_iyxA==&ref=11175313","dk0":"notice","v":[{"l":"วิดีโอก่อนการประชุม","h":"/commerce/2569/s/v-industry-18-pre.html","du":"1:45","k":"pre"}],"ph":0,"ao":0,"cx":0,"read":"/commerce/2569/sub-industry.html#read-18"},{"k":"v","t":"วิดีโอก่อนการประชุม · ความคืบหน้ารายงานการพิจารณาศึกษา และการเตรียมจัดเสวนา","u":"/commerce/2569/s/v-industry-18-pre.html","c":"commerce","sb":36,"n":18,"y":2569,"d":"2026-11-16","du":"1:45","vk":"pre","po":"/commerce/2569/img/poster-sub-industry-18pre.jpg","mu":"/commerce/2569/m/industry-18.html","cap":"คณะอนุกรรมาธิการอุตสาหกรรม ในคณะกรรมาธิการการพาณิชย์และการอุตสาหกรรม วุฒิสภา นัดประชุมครั้งที่ 18/2569 วันจันทร์ที่ 16 พฤศจิกายน 2569 เวลา 13.00 นาฬิกา ครั้งนี้ประชุมผ่านสื่ออิเล็กทรอนิกส์ เพื่อให้สอดคล้องกับมาตรการประหยัดพลังงานตามมติคณะรัฐมนตรี ประธานคณะอนุกรรมาธิการ คือ นายวีรยุทธ สร้อยทอง คณะอนุกรรมาธิการนี้ อยู่ในคณะกรรมาธิการการพาณิชย์และการอุตสาหกรรม ซึ่งมีนายวิวรรธน์ ไกรพิสิทธิ์กุล เป็นประธาน ตามหนังสือนัดประชุม ระเบียบวาระมี 4 ข้อ ข้อ 1 เรื่องที่ประธานจะแจ้งต่อที่ประชุม ข้อ 2 รับรองบันทึกการประชุม ข้อ 3 เรื่องเสนอเพื่อพิจารณา 2 เรื่อง และข้อ 4 เรื่องอื่น ๆ เรื่องแรก พิจารณาความคืบหน้าการจัดทำรายงานการพิจารณาศึกษาของคณะอนุกรรมาธิการ เรื่องที่สอง พิจารณาเตรียมความพร้อมในการจัดเสวนาของคณะอนุกรรมาธิการ ข้อมูลที่เผยแพร่แล้ว จากสรุปผลการประชุมของคณะกรรมาธิการ เมื่อวันที่ 11 พฤศจิกายน 2569 คณะอนุกรรมาธิการนี้ จัดทำรายงานเรื่องการยกระดับอุตสาหกรรมเซมิคอนดักเตอร์ ครบทั้ง 5 บทแล้ว และกำหนดจัดเสวนาเผยแพร่ผลการศึกษา วันที่ 27 พฤศจิกายน 2569 หัวข้อ การขับเคลื่อนอุตสาหกรรมอิเล็กทรอนิกส์แห่งอนาคต ข้อมูลนี้มาจากหนังสือนัดประชุมของคณะอนุกรรมาธิการ กำหนดการอาจเปลี่ยนแปลงได้ ติดตามผลการประชุม ได้ทางช่องทางของสำนักงานเลขาธิการวุฒิสภา","tg":["อุตสาหกรรม","วาระการประชุม"]},{"k":"m","t":"การประชุมคณะอนุกรรมาธิการอุตสาหกรรม ครั้งที่ 17/2569","u